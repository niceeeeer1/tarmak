{
  "name": "tarmak-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-tarmak",
    "test": "firebase emulators:exec --only firestore --project demo-tarmak \"node --test tests/rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/seed.mjs demo-tarmak"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.34.2",
    "firebase-admin": "14.5.0"
  }
}